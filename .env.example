# Copia este archivo a .env (local) o cárgalo como "secrets/variables" en GitHub/hosting.
# SOLO claves PÚBLICAS en el frontend. NUNCA pongas aquí service_role, tokens de WhatsApp/Meta ni llaves VAPID privadas.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_O_PUBLISHABLE

# Llave VAPID PÚBLICA (opcional; solo para avisos push en la PWA instalada). La privada va como secret de la Edge Function.
VITE_VAPID_PUBLIC_KEY=

# URL HTTPS pública de la app (la del hosting). Necesaria para que el botón "Compartir enlace" funcione desde la app de iPhone (IPA).
VITE_PUBLIC_BOOKING_URL=

# Solo para ver la app con datos de ejemplo y sin Supabase (nunca para producción):
# VITE_DEMO_MODE=true
