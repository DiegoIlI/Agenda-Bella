{
  "name": "agenda-bella",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:demo": "vite --host 0.0.0.0 --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/validate.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:sql": "bash tests/sql/run_all.sh",
    "test:e2e": "node tests/e2e/flujos.mjs",
    "sync:ios": "npm run build && cap sync ios",
    "dev:site": "vite --config website/vite.config.js",
    "build:site": "vite build --config website/vite.config.js && vite build --outDir dist/reservar"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/playfair-display": "5.2.8",
    "@supabase/supabase-js": "^2.49.0",
    "gsap": "^3.12.7",
    "lenis": "^1.3.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.63.0",
    "vite": "^6.0.6"
  }
}
